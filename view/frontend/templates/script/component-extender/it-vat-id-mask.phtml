<script>
    LokiComponentExtender.extend(['LokiCheckoutComponent', 'LokiCheckoutVatEuIdFieldComponent'], 'ItVatIdMaskMixin', () => {
        return {
            itVatIdMask(input) {
                return /^[A-Z]/i.test(input)
                    ? 'aa99999999999'
                    : '99999999999';
            }
        }
    }, {when: component => component.fieldName === 'vat_id'});
</script>
