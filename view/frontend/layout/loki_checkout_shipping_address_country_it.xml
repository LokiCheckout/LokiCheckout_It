<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki-checkout.shipping.address.street0">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Street Name</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.street1">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Housenumber</argument>
                <argument name="col_span" xsi:type="number">6</argument>
                <argument name="md_col_span" xsi:type="number">3</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.street2">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Addition</argument>
                <argument name="col_span" xsi:type="number">6</argument>
                <argument name="md_col_span" xsi:type="number">3</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.postcode">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Postal code</argument>
                <argument name="placeholder" xsi:type="string">00184</argument>
                <argument name="field_attributes" xsi:type="array">
                    <item name="x-mask" xsi:type="string">99999</item>
                </argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.region">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Province</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.telephone">
            <arguments>
                <argument name="placeholder" xsi:type="string">+39 312 345 6789</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.vat_id">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">VAT number or tax code</argument>
                <argument name="placeholder" xsi:type="string">IT12345678901</argument>
                <argument name="field_attributes" xsi:type="array">
                    <item name="x-mask:dynamic" xsi:type="string">itVatIdMask</item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
